# Copy this file to .env.production for the current docker-compose.yml.
# Replace every placeholder before starting the app.
# This combined file covers the web app, backend, task queue, database package,
# and evaluation tools. Keep real credentials out of this example file.

# Shared services
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/queryai
REDIS_URL=redis://localhost:6379

# Encryption key used to encrypt saved database credentials.
# Generate a valid Fernet key for this value.
ENCRYPTION_KEY=replace-with-valid-fernet-key

# Clerk authentication
CLERK_SECRET_KEY=sk_test_replace_me
CLERK_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me

# Public URL the user's browser uses to reach the backend.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Vector search
QDRANT_URL=https://your-qdrant-host
QDRANT_API_KEY=replace_me
QDRANT_COLLECTION=queryai

# Model providers
OPENROUTER_API_KEY=replace_me
DEEPSEEK_API_KEY=replace_me
MEM0_API_KEY=replace_me
CONFIDENT_API_KEY=replace_me
CMD_API_KEY=replace_me

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=replace_me
LANGSMITH_PROJECT=queryai

# Sample database connection
SAMPLE_DB_HOST=localhost
SAMPLE_DB_PORT=5432
SAMPLE_DB_USER=replace_me
SAMPLE_DB_PASSWORD=replace_me
