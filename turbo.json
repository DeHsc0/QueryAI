{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "futureFlags": {
    "experimentalPythonWorkspaces": true
  },
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "cache" : false,
      "persistent" : true,
      "outputs": [".next/**", "!.next/cache/**" , ".venv" , "uv.lock"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": true,
      "persistent": true
    },
    "start": {
      "cache": true,
      "persistent": true
    }
  }
}
