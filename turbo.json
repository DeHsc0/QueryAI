{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "ENCRYPTION_KEY",
    "CLERK_SECRET_KEY",
    "CLERK_WEBHOOK_SECRET",
    "NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_BACKEND_URL",
    "QDRANT_URL",
    "QDRANT_API_KEY",
    "QDRANT_COLLECTION",
    "OPENROUTER_API_KEY",
    "DEEPSEEK_API_KEY",
    "MEM0_API_KEY",
    "CONFIDENT_API_KEY",
    "CMD_API_KEY",
    "LANGSMITH_TRACING",
    "LANGSMITH_ENDPOINT",
    "LANGSMITH_API_KEY",
    "LANGSMITH_PROJECT",
    "SAMPLE_DB_HOST",
    "SAMPLE_DB_PORT",
    "SAMPLE_DB_USER",
    "SAMPLE_DB_PASSWORD"
  ],
  "futureFlags": {
    "experimentalPythonWorkspaces": true
  },
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "cache" : false,
      "persistent" : true,
      "outputs": [".next/**", "!.next/cache/**" , ".venv" , "uv.lock"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": true,
      "persistent": true
    },
    "start": {
      "cache": true,
      "persistent": true
    }
  }
}
